# Contact form delivery (app/api/contact/route.ts)
#
# Copy to .env.local for local development, and set the same keys in
# Vercel → Settings → Environment Variables for production.
#
# Without RESEND_API_KEY the contact form returns 503 and shows its
# email/phone fallback. Nothing else on the site depends on these.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to site.contact.inbox (national@studentsforailiteracy.org).
CONTACT_TO=

# Optional. Must sit on a domain verified in Resend.
#
# Verify a SUBDOMAIN, not the apex: studentsforailiteracy.org already carries
# Google Workspace MX records, and pointing Resend at the apex collides with
# them. Add send.studentsforailiteracy.org in Resend, copy its DNS records into
# Namecheap, then use an address on that subdomain here.
CONTACT_FROM="SAIL Website <website@send.studentsforailiteracy.org>"
